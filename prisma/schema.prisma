generator client {
  provider = "prisma-client"
  output   = "../src/lib/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model AcademicSetting {
  id String @id

  currentYear          String
  currentSemester      Semester
  currentPrincipalName String
  schoolName           String
  schoolAddress        String

  updatedAt DateTime @updatedAt
  updatedBy String?

  @@map("academic_setting")
}

model User {
  id            String  @id
  name          String
  email         String? @unique
  emailVerified Boolean @default(false)

  // Username Plugin
  username        String  @unique
  displayUsername String?

  // Admin Plugin
  banned     Boolean?  @default(false)
  banReason  String?
  banExpires DateTime?

  role        Role       @default(STUDENT)
  phoneNumber String?
  birthDate   DateTime?
  birthPlace  String?
  address     String?
  gender      Gender?
  bloodType   BloodType?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions            Session[]
  accounts            Account[]
  coordinatorProfiles CoordinatorProfile[]
  teacherProfiles     TeacherProfile[]
  studentProfiles     StudentProfile[]

  @@map("user")
}

model Session {
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Admin Plugin
  impersonatedBy String?

  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("session")
}

model Account {
  id String @id

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  accountId  String
  providerId String

  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  idToken               String?
  password              String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("account")
}

model Verification {
  id         String @id
  identifier String
  value      String

  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("verification")
}

model CoordinatorProfile {
  userId String @id
  nip    String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  tashihRequests      TashihRequest[]
  tashihSchedules     TashihSchedule[]
  tashihResults       TashihResult[]
  munaqasyahRequests  MunaqasyahRequest[]
  munaqasyahSchedules MunaqasyahSchedule[]

  @@index([nip])
  @@map("coordinator_profile")
}

model TeacherProfile {
  userId String @id
  nip    String @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user                          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  groups                        Group[]
  submissions                   Submission[]
  weeklyTargets                 WeeklyTarget[]
  tashihRequests                TashihRequest[]
  munaqasyahRequests            MunaqasyahRequest[]
  munaqasyahSchedulesAsExaminer MunaqasyahSchedule[]

  @@index([nip])
  @@map("teacher_profile")
}

model StudentProfile {
  userId      String  @id
  nis         String  @unique
  nisn        String? @unique
  classroomId String?
  groupId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  status      StudentStatus @default(AKTIF)
  graduatedAt DateTime?

  user                   User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  classroom              Classroom?              @relation(fields: [classroomId], references: [id])
  classroomHistories     ClassroomHistory[]
  group                  Group?                  @relation(fields: [groupId], references: [id])
  groupHistories         GroupHistory[]
  submissions            Submission[]
  homeActivities         HomeActivity[]
  weeklyTargets          WeeklyTarget[]
  tashihRequests         TashihRequest[]
  tahfidzScores          TahfidzScore[]
  tahsinScores           TahsinScore[]
  reports                Report[]
  munaqasyahRequests     MunaqasyahRequest[]
  munaqasyahFinalResults MunaqasyahFinalResult[]

  @@index([nis])
  @@map("student_profile")
}

model Classroom {
  id           String   @id @unique
  level        Int
  name         String
  academicYear String
  semester     Semester
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classroomHistories ClassroomHistory[]
  students           StudentProfile[]
  groups             Group[]

  @@unique([name, academicYear, semester])
  @@map("classroom")
}

model ClassroomHistory {
  id           String   @id @default(uuid())
  studentId    String
  classroomId  String
  academicYear String
  semester     Semester

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classroom Classroom      @relation(fields: [classroomId], references: [id], onDelete: Restrict)
  student   StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([studentId, academicYear, semester])
  @@map("classroom_history")
}

model Group {
  id          String  @id @unique
  name        String
  classroomId String
  teacherId   String
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  classroom              Classroom               @relation(fields: [classroomId], references: [id])
  teacher                TeacherProfile          @relation(fields: [teacherId], references: [userId])
  students               StudentProfile[]
  groupHistories         GroupHistory[]
  submissions            Submission[]
  homeActivities         HomeActivity[]
  weeklyTargets          WeeklyTarget[]
  tashihRequests         TashihRequest[]
  tahfidzScores          TahfidzScore[]
  tahsinScores           TahsinScore[]
  reports                Report[]
  munaqasyahRequests     MunaqasyahRequest[]
  munaqasyahFinalResults MunaqasyahFinalResult[]

  @@unique([name, classroomId])
  @@map("group")
}

model GroupHistory {
  id           String   @id @default(uuid())
  studentId    String
  groupId      String
  academicYear String
  semester     Semester

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group   Group          @relation(fields: [groupId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)

  @@unique([studentId, academicYear, semester])
  @@map("group_history")
}

model Surah {
  id         Int    @id
  name       String
  verseCount Int

  surahJuz             SurahJuz[]
  submissions          Submission[]
  homeActivities       HomeActivity[]
  weeklyTargetsAsStart WeeklyTarget[]  @relation("StartSurah")
  weeklyTargetsAsEnd   WeeklyTarget[]  @relation("EndSurah")
  tashihRequests       TashihRequest[]
  tahfidzScores        TahfidzScore[]
  tasmiDetails         TasmiDetail[]

  @@map("surah")
}

model Juz {
  id   Int    @id
  name String

  surahJuz               SurahJuz[]
  submissions            Submission[]
  homeActivities         HomeActivity[]
  tashihRequests         TashihRequest[]
  munaqasyahRequests     MunaqasyahRequest[]
  munaqasyahFinalResults MunaqasyahFinalResult[]

  @@map("juz")
}

model SurahJuz {
  id         Int @id
  surahId    Int
  juzId      Int
  startVerse Int
  endVerse   Int

  surah Surah @relation(fields: [surahId], references: [id])
  juz   Juz   @relation(fields: [juzId], references: [id])

  @@index([surahId])
  @@index([juzId])
  @@map("surah_juz")
}

model Wafa {
  id        Int    @id
  name      String
  pageCount Int

  submissions    Submission[]
  weeklyTargets  WeeklyTarget[]
  tashihRequests TashihRequest[]

  @@map("wafa")
}

model Submission {
  id        String @id
  studentId String
  teacherId String
  groupId   String

  date           DateTime
  submissionType SubmissionType

  juzId      Int?
  surahId    Int?
  startVerse Int?
  endVerse   Int?

  wafaId    Int?
  startPage Int?
  endPage   Int?

  adab             Adab
  submissionStatus SubmissionStatus
  note             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  teacher TeacherProfile @relation(fields: [teacherId], references: [userId])
  group   Group          @relation(fields: [groupId], references: [id])
  juz     Juz?           @relation(fields: [juzId], references: [id])
  surah   Surah?         @relation(fields: [surahId], references: [id])
  wafa    Wafa?          @relation(fields: [wafaId], references: [id])

  @@index([date])
  @@map("submission")
}

model HomeActivity {
  id        String @id @default(uuid())
  studentId String
  groupId   String

  date         DateTime
  activityType HomeActivityType

  juzId      Int
  surahId    Int
  startVerse Int
  endVerse   Int
  note       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  group   Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  juz     Juz            @relation(fields: [juzId], references: [id])
  surah   Surah          @relation(fields: [surahId], references: [id])

  @@index([date])
  @@map("home_activity")
}

model WeeklyTarget {
  id        String @id @default(uuid())
  studentId String
  teacherId String
  groupId   String

  type            SubmissionType
  startDate       DateTime
  endDate         DateTime
  description     String
  status          TargetStatus   @default(TIDAK_TERCAPAI)
  progressPercent Int?           @default(0)

  surahStartId Int?
  surahEndId   Int?
  startAyat    Int?
  endAyat      Int?

  wafaId    Int?
  startPage Int?
  endPage   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student    StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  teacher    TeacherProfile @relation(fields: [teacherId], references: [userId])
  group      Group          @relation(fields: [groupId], references: [id])
  surahStart Surah?         @relation("StartSurah", fields: [surahStartId], references: [id])
  surahEnd   Surah?         @relation("EndSurah", fields: [surahEndId], references: [id])
  wafa       Wafa?          @relation(fields: [wafaId], references: [id])

  @@index([startDate])
  @@map("weekly_target")
}

enum SubmissionType {
  TAHFIDZ
  TAHSIN_WAFA
  TAHSIN_ALQURAN
}

enum SubmissionStatus {
  LULUS
  TIDAK_LULUS
  MENGULANG
}

enum Adab {
  BAIK
  KURANG_BAIK
  TIDAK_BAIK
}

enum HomeActivityType {
  MURAJAAH
  TILAWAH
  TARJAMAH
}

enum TargetStatus {
  TIDAK_TERCAPAI
  TERCAPAI
}

model TashihRequest {
  id            String  @id @default(uuid())
  studentId     String
  teacherId     String
  groupId       String
  coordinatorId String?

  tashihType TashihType
  juzId      Int?
  surahId    Int?
  wafaId     Int?
  startPage  Int?
  endPage    Int?
  status     TashihRequestStatus @default(MENUNGGU)
  notes      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student          StudentProfile          @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  teacher          TeacherProfile          @relation(fields: [teacherId], references: [userId])
  group            Group                   @relation(fields: [groupId], references: [id])
  coordinator      CoordinatorProfile?     @relation(fields: [coordinatorId], references: [userId])
  juz              Juz?                    @relation(fields: [juzId], references: [id])
  surah            Surah?                  @relation(fields: [surahId], references: [id])
  wafa             Wafa?                   @relation(fields: [wafaId], references: [id])
  scheduleRequests TashihScheduleRequest[]
  result           TashihResult?

  @@map("tashih_request")
}

model TashihSchedule {
  id            String @id @default(uuid())
  coordinatorId String

  date        DateTime
  sessionName String
  startTime   String
  endTime     String
  location    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coordinator      CoordinatorProfile      @relation(fields: [coordinatorId], references: [userId])
  scheduleRequests TashihScheduleRequest[]
  results          TashihResult[]

  @@unique([date, sessionName, startTime, endTime, location])
  @@map("tashih_schedule")
}

model TashihScheduleRequest {
  scheduleId String
  requestId  String

  schedule TashihSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  request  TashihRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([scheduleId, requestId])
  @@map("tashih_schedule_request")
}

model TashihResult {
  id            String @id @default(uuid())
  coordinatorId String
  scheduleId    String
  requestId     String @unique

  passed Boolean
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coordinator CoordinatorProfile @relation(fields: [coordinatorId], references: [userId])
  schedule    TashihSchedule     @relation(fields: [scheduleId], references: [id])
  request     TashihRequest      @relation(fields: [requestId], references: [id])

  @@unique([scheduleId, requestId])
  @@map("tashih_result")
}

enum TashihType {
  ALQURAN
  WAFA
}

enum TashihRequestStatus {
  MENUNGGU
  DITERIMA
  DITOLAK
  SELESAI
}

model TahfidzScore {
  id          String      @id @default(uuid())
  studentId   String
  groupId     String
  surahId     Int
  score       Int
  grade       GradeLetter
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  group   Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)
  surah   Surah          @relation(fields: [surahId], references: [id])

  @@unique([studentId, groupId, surahId])
  @@map("tahfidz_score")
}

model TahsinScore {
  id          String      @id @default(uuid())
  studentId   String
  groupId     String
  tahsinType  TahsinType
  topic       String
  score       Int
  grade       GradeLetter
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  group   Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId, tahsinType, topic])
  @@map("tahsin_score")
}

model Report {
  id                 String   @id @default(uuid())
  studentId          String
  groupId            String
  academicYear       String
  semester           Semester
  tahfidzScore       Float?
  tahsinScore        Float?
  lastTahsinMaterial String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [userId], onDelete: Cascade)
  group   Group          @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId, academicYear, semester])
  @@map("report")
}

enum GradeLetter {
  A
  B
  C
  D
}

enum TahsinType {
  WAFA
  ALQURAN
}

model MunaqasyahRequest {
  id            String  @id @default(uuid())
  coordinatorId String?
  teacherId     String
  studentId     String
  groupId       String

  batch  MunaqasyahBatch
  stage  MunaqasyahStage
  juzId  Int
  status MunaqasyahRequestStatus @default(MENUNGGU)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coordinator      CoordinatorProfile?         @relation(fields: [coordinatorId], references: [userId])
  teacher          TeacherProfile              @relation(fields: [teacherId], references: [userId])
  student          StudentProfile              @relation(fields: [studentId], references: [userId])
  group            Group                       @relation(fields: [groupId], references: [id])
  juz              Juz                         @relation(fields: [juzId], references: [id])
  scheduleRequests MunaqasyahScheduleRequest[]
  result           MunaqasyahResult?

  @@map("munaqasyah_request")
}

model MunaqasyahSchedule {
  id            String @id @default(uuid())
  coordinatorId String

  date        DateTime
  sessionName String
  startTime   String
  endTime     String
  location    String
  examinerId  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  coordinator      CoordinatorProfile          @relation(fields: [coordinatorId], references: [userId])
  examiner         TeacherProfile?             @relation(fields: [examinerId], references: [userId])
  scheduleRequests MunaqasyahScheduleRequest[]
  results          MunaqasyahResult[]

  @@unique([date, sessionName, startTime, endTime, location])
  @@map("munaqasyah_schedule")
}

model MunaqasyahScheduleRequest {
  scheduleId String
  requestId  String

  schedule MunaqasyahSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  request  MunaqasyahRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@id([scheduleId, requestId])
  @@map("munaqasyah_schedule_request")
}

model MunaqasyahResult {
  id         String @id @default(uuid())
  requestId  String @unique
  scheduleId String

  totalScore Float
  grade      MunaqasyahGrade
  passed     Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  request            MunaqasyahRequest      @relation(fields: [requestId], references: [id])
  schedule           MunaqasyahSchedule     @relation(fields: [scheduleId], references: [id])
  tasmiDetails       TasmiDetail[]
  munaqasyahDetails  MunaqasyahDetail[]
  tasmiForFinal      MunaqasyahFinalResult? @relation("TasmiResult")
  munaqasyahForFinal MunaqasyahFinalResult? @relation("MunaqasyahResult")

  @@unique([requestId, scheduleId])
  @@map("munaqasyah_result")
}

model TasmiDetail {
  id       String @id @default(uuid())
  resultId String

  surahId              Int
  initialScore         Int
  khofiAwalAyat        Int
  khofiMakhroj         Int
  khofiTajwidMad       Int
  jaliBaris            Int
  jaliLebihSatuKalimat Int
  totalScore           Float
  note                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result MunaqasyahResult @relation(fields: [resultId], references: [id], onDelete: Cascade)
  surah  Surah            @relation(fields: [surahId], references: [id])

  @@unique([resultId, surahId])
  @@map("tasmi_detail")
}

model MunaqasyahDetail {
  id       String @id @default(uuid())
  resultId String

  questionNo           Int
  initialScore         Int     @default(50)
  khofiAwalAyat        Int
  khofiMakhroj         Int
  khofiTajwidMad       Int
  jaliBaris            Int
  jaliLebihSatuKalimat Int
  totalScore           Float
  note                 String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  result MunaqasyahResult @relation(fields: [resultId], references: [id], onDelete: Cascade)

  @@unique([resultId, questionNo])
  @@map("munaqasyah_detail")
}

model MunaqasyahFinalResult {
  id        String          @id @default(uuid())
  studentId String
  groupId   String
  juzId     Int
  batch     MunaqasyahBatch

  tasmiResultId      String @unique
  munaqasyahResultId String @unique

  finalScore Float
  finalGrade MunaqasyahGrade
  passed     Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student          StudentProfile   @relation(fields: [studentId], references: [userId])
  group            Group            @relation(fields: [groupId], references: [id])
  juz              Juz              @relation(fields: [juzId], references: [id])
  tasmiResult      MunaqasyahResult @relation("TasmiResult", fields: [tasmiResultId], references: [id])
  munaqasyahResult MunaqasyahResult @relation("MunaqasyahResult", fields: [munaqasyahResultId], references: [id])

  @@unique([studentId, juzId, batch])
  @@map("munaqasyah_final_result")
}

enum MunaqasyahBatch {
  TAHAP_1
  TAHAP_2
  TAHAP_3
  TAHAP_4
}

enum MunaqasyahStage {
  TASMI
  MUNAQASYAH
}

enum MunaqasyahRequestStatus {
  MENUNGGU
  DITERIMA
  DITOLAK
  SELESAI
}

enum MunaqasyahGrade {
  MUMTAZ
  JAYYID_JIDDAN
  JAYYID
  TIDAK_LULUS
}

enum Semester {
  GANJIL
  GENAP
}

enum Role {
  SUPERADMIN
  ADMIN
  COORDINATOR
  TEACHER
  STUDENT
}

enum Gender {
  MALE
  FEMALE
}

enum BloodType {
  A
  B
  AB
  O
}

enum StudentStatus {
  AKTIF
  LULUS
  PINDAH
  KELUAR
}
