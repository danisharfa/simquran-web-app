# Copy this file to `.env` and fill in the values for your environment.

# PostgreSQL connection string used by Prisma (via @prisma/adapter-pg).
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL="postgresql://postgres:password@localhost:5432/simquran_db"

# better-auth
# Generate a strong random secret, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public base URL of the app (no trailing slash). Use the production domain when deploying.
BETTER_AUTH_URL=http://localhost:3000
